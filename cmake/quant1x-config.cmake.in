@PACKAGE_INIT@

set_and_check(QUANT1X_INCLUDE_DIR "@CMAKE_INSTALL_PREFIX@/include")
set_and_check(THIRD_PARTY_INCLUDE_DIR "@CMAKE_INSTALL_PREFIX@/include/third_party")

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(OpenSSL REQUIRED)
find_dependency(Iconv REQUIRED)
find_dependency(yaml-cpp CONFIG REQUIRED)
find_dependency(CapnProto CONFIG REQUIRED)
find_dependency(mimalloc CONFIG REQUIRED)
find_dependency(cpr CONFIG REQUIRED)
find_dependency(ZLIB REQUIRED)
#find_dependency(fmt CONFIG REQUIRED)
# date dependency: some Clang builds (non-Windows) need date::date-tz
# Only add this dependency when the consuming project is building with
# Clang/AppleClang on a non-Windows platform.
if(NOT WIN32 AND (CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang"))
    find_dependency(date CONFIG REQUIRED)
endif()
#find_dependency(spdlog CONFIG REQUIRED)
#find_dependency(unofficial-duktape CONFIG REQUIRED)
find_dependency(unofficial-minizip CONFIG REQUIRED)
find_dependency(benchmark REQUIRED)
find_dependency(Catch2 CONFIG REQUIRED)
find_dependency(GTest CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/quant1x-targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/quant1x-config-version.cmake")

# 导出给外部项目使用
set(quant1x_INCLUDE_DIRS
    ${QUANT1X_INCLUDE_DIR}
    ${THIRD_PARTY_INCLUDE_DIR}
)