# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
*.copy

*.csv
__pycache__/
.eggs/
build/
dist/
*.egg-info/

*.png
# 应用与网站图标是交付物, 需入库 (由 scripts/gen_icons.py 从 logo.png 生成)
!assets/icons/**/*.png

*.pkl

#visual studio
.vs/
out/

# CMake specific
*build*/
# `cmake --system-information` 的转储工程，由外部调用以仓库根为工作目录时产生
__cmake_systeminformation/
cmake-build*/
# Conan 生成的用户级预设（每次 conan install 重新生成）
CMakeUserPresets.json

# 临时工作目录（不跟踪）：测试性代码、一次性脚本、抓取数据与中间产物
temp/

# 历史遗留：vcpkg 已迁移到 Conan，保留忽略以防本地残留目录
vcpkg_installed/

# Rust specific
target/

# CLion
.cache/

.env

# vscode
.vscode/

# setuptools_scm generated version file
_version.py

# Maven Wrapper 下载缓存（首次运行自动下载，不入库）
.mvn/

# Go 工作区：go.work / go.work.sum 属于本机多模块编排，不入库
go.work
go.work.sum
