{
    // vcpkg 全局根目录: CMakeLists.txt 在 DEFINED ENV{VCPKG_ROOT} 缺失时 FATAL_ERROR,
    // 故此处显式给出, 不依赖外部终端环境。工具链文件由同一根目录推导。
    "cmake.configureEnvironment": {
        "VCPKG_ROOT": "d:\\runtime\\vcpkg"
    },
    "cmake.configureSettings": {
        "CMAKE_TOOLCHAIN_FILE": "d:\\runtime\\vcpkg\\scripts\\buildsystems\\vcpkg.cmake"
    },
    // 数组整体替换, 故 Windows 层须重述公共项 + 平台项
    "cmake.configureArgs": [
        "-DVCPKG_APPLOCAL_DEPS=ON",
        "-DVCPKG_PREFER_SYSTEM_LIBS=OFF",
        "-DVCPKG_TARGET_TRIPLET=x64-windows",
        "-DVCPKG_MANIFEST_MODE=OFF"
    ],
    "vcpkg.target.hostTriplet": "x64-windows",
    "vcpkg.target.defaultTriplet": "x64-windows"
}
